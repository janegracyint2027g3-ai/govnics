# ==============================================================================
# GOVENICS GRC PLATFORM — ENVIRONMENT CONFIGURATION TEMPLATE
# Phase 3: AI Knowledge Hub & Agent Intelligence Engine
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. UPSTASH REDIS (Persistent Key-Value & Knowledge Storage)
# ------------------------------------------------------------------------------
# Required for persistent KRM storage, Knowledge documents, chunks, and audit logs.
# Obtain from Upstash Console -> Redis Database Details -> REST API
UPSTASH_REDIS_REST_URL=https://your-upstash-redis-instance.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_redis_rest_token_here

# ------------------------------------------------------------------------------
# 2. AI MODEL PROVIDERS (Optional / Production Embedding & Generation)
# ------------------------------------------------------------------------------
# Primary model provider for advanced embeddings and reasoning:
GEMINI_API_KEY=your_gemini_api_key_here

# Fallback LLM provider (optional):
OPENAI_API_KEY=your_openai_api_key_here

# External Vector Database (optional; default uses native hybrid BM25 + Vector):
PINECONE_API_KEY=your_pinecone_api_key_here
PINECONE_INDEX=govenics-knowledge-hub

# ------------------------------------------------------------------------------
# 3. EXISTING GOVENICS INTEGRATIONS & TELEMETRY
# ------------------------------------------------------------------------------
VITE_TELEMETRY_WEBHOOK_URL=https://hook.eu2.make.com/your_webhook_id
GOOGLE_SHEETS_URL=https://script.google.com/macros/s/your_macro_id/exec
ANALYTICS_SHEET_URL=https://script.google.com/macros/s/your_analytics_macro_id/exec

# ------------------------------------------------------------------------------
# 4. APPLICATION ENVIRONMENT
# ------------------------------------------------------------------------------
NODE_ENV=production
PORT=3000

